      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (service_name, error_type) (rate(dotnet_exceptions_total{service_name=~\"$service\"}[$interval]))",
          "legendFormat": "{{service_name}} \u00b7 {{error_type}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (service_name, error_type) (rate(aspnetcore_diagnostics_exceptions_total{service_name=~\"$service\"}[$interval]))",
          "legendFormat": "{{service_name}} \u00b7 [ASP.NET] {{error_type}}"
