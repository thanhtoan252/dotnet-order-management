    {
      "id": 40,
      "type": "timeseries",
      "title": "Exception rate (.NET runtime + EF Core / DB)",
      "description": "Rate of thrown .NET exceptions by service and error_type. EF Core / database exceptions appear as types like DbUpdateException, DbUpdateConcurrencyException, NpgsqlException, SqlException. ASP.NET Core unhandled exceptions are added as a separate series.",
